{
  "openapi": "3.1.0",
  "info": {
    "title": "MarketTEC Notifications API",
    "version": "0.3.0-draft",
    "description": "Protected notification history, read-state and authenticated SSE API. Production authentication and APIM validation remain subject to MTEC-10, MTEC-12 and MTEC-15."
  },
  "paths": {
    "/v1/notifications": {
      "get": {
        "operationId": "listNotifications",
        "summary": "List notifications belonging to the authenticated user",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/CorrelationId"},
          {
            "name": "pageSize",
            "in": "query",
            "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {"type": "string", "minLength": 1, "maxLength": 2048}
          }
        ],
        "responses": {
          "200": {
            "description": "Stable newest-first page",
            "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationPage"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    },
    "/v1/notifications/stream": {
      "get": {
        "operationId": "streamNotifications",
        "summary": "Stream notifications belonging to the authenticated user",
        "description": "Use a fetch-based SSE client so the Bearer token remains in the Authorization header. Never place access tokens in the URL.",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/CorrelationId"},
          {"$ref": "#/components/parameters/LastEventId"}
        ],
        "responses": {
          "200": {
            "description": "SSE notification, resync and heartbeat frames",
            "headers": {
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"},
              "Cache-Control": {"schema": {"type": "string"}}
            },
            "content": {"text/event-stream": {"schema": {"type": "string"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "429": {"$ref": "#/components/responses/TooManyConnections"}
        }
      }
    },
    "/v1/notifications/{notificationId}/read": {
      "patch": {
        "operationId": "markNotificationRead",
        "summary": "Idempotently mark one owned notification as read",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/CorrelationId"},
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "Updated notification; repeated calls return the same read state",
            "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Notification"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    },
    "parameters": {
      "CorrelationId": {
        "name": "X-Correlation-ID",
        "in": "header",
        "schema": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}
      },
      "LastEventId": {
        "name": "Last-Event-ID",
        "in": "header",
        "description": "UUID of the last notification completely processed by the client",
        "schema": {"type": "string", "format": "uuid"}
      }
    },
    "headers": {
      "CorrelationId": {"schema": {"type": "string"}}
    },
    "schemas": {
      "Notification": {
        "type": "object",
        "additionalProperties": false,
        "required": ["notificationId", "eventId", "senderUserId", "chatId", "messageId", "occurredAt", "correlationId", "createdAt", "isRead"],
        "properties": {
          "notificationId": {"type": "string", "format": "uuid"},
          "eventId": {"type": "string", "format": "uuid"},
          "senderUserId": {"type": "string"},
          "chatId": {"type": "string"},
          "messageId": {"type": "string"},
          "occurredAt": {"type": "integer", "minimum": 0, "description": "Epoch seconds"},
          "correlationId": {"type": "string"},
          "createdAt": {"type": "integer", "minimum": 0, "description": "Epoch seconds"},
          "isRead": {"type": "boolean"}
        }
      },
      "NotificationPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/Notification"}},
          "nextCursor": {"type": ["string", "null"]}
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "correlationId"],
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"},
              "correlationId": {"type": "string"}
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {"description": "Invalid parameters or cursor", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "Unauthenticated": {"description": "Missing or invalid authentication", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "Forbidden": {"description": "Principal lacks the required permission", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "NotFound": {"description": "Notification not visible to this principal", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "TooManyConnections": {"description": "Per-user or service connection limit reached", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}
    }
  }
}
