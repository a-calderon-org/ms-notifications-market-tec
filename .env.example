APP_NAME=ms-notifications
APP_ENV=development
LOG_LEVEL=INFO
AZURE_LOCATION=canadacentral
AUTHENTICATION_MODE=reject_all
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
JWT_JWKS_JSON=
JWT_DEFAULT_PERMISSIONS=notifications:read notifications:write
JWT_MAX_TTL_SECONDS=240
JWT_JWKS_TIMEOUT_SECONDS=5
JWT_JWKS_CACHE_SECONDS=300
# Shared secret injected only by APIM (named value notifications-backend-key).
# Empty disables the direct-access gate; when set it must have 32+ characters.
APIM_GATEWAY_KEY=
NOTIFICATIONS_REPOSITORY=memory
MONGODB_URI=
MONGODB_DATABASE=market_tec_notifications
MONGODB_COLLECTION=notifications

AZURE_STORAGE_QUEUE_ENDPOINT=
AZURE_QUEUE_NAME=message-sent-v1
AZURE_POISON_QUEUE_NAME=message-sent-v1-poison
QUEUE_VISIBILITY_TIMEOUT_SECONDS=30
QUEUE_MAX_DEQUEUE_COUNT=5
QUEUE_POLL_INTERVAL_SECONDS=5

SSE_POLL_INTERVAL_SECONDS=2
SSE_HEARTBEAT_INTERVAL_SECONDS=15
SSE_BATCH_SIZE=100
SSE_MAX_CONNECTIONS=100
SSE_MAX_CONNECTIONS_PER_USER=3
SSE_MAX_CONNECTION_DURATION_SECONDS=300

